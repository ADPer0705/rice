# Normalize text files to LF so the repo behaves the same on NTFS and ext4
* text=auto eol=lf

# Scripts must keep LF
*.sh   text eol=lf
*.zsh  text eol=lf
*.lua  text eol=lf
*.conf text eol=lf

# Binary assets
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ttf  binary
*.otf  binary
*.woff binary
*.woff2 binary
*.zip  binary
*.gz   binary
*.xz   binary
