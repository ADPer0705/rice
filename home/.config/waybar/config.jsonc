{
    "layer": "top",
    "position": "top",
    "height": 32,
    "margin-top": 8,
    "margin-left": 12,
    "margin-right": 12,
    "spacing": 8,

    "modules-left": ["custom/core", "hyprland/workspaces"],
    "modules-center": ["clock"],
    "modules-right": ["cpu", "memory", "temperature", "network", "pulseaudio", "battery"],

    "custom/core": {
        "format": "◈ debie",
        "tooltip": false
    },
    "hyprland/workspaces": {
        "format": "{id}",
        "on-click": "activate"
    },
    "clock": {
        "format": "⧖ {:%H:%M:%S  //  %a %d %b}",
        "interval": 1,
        "tooltip-format": "<tt>{calendar}</tt>"
    },
    "cpu": {
        "format": "CPU {usage}%",
        "interval": 2
    },
    "memory": {
        "format": "MEM {percentage}%",
        "interval": 3
    },
    "temperature": {
        "critical-threshold": 85,
        "format": "TMP {temperatureC}°C"
    },
    "network": {
        "format-wifi": "NET {essid} ({signalStrength}%)",
        "format-ethernet": "NET ETH",
        "format-disconnected": "NET OFFLINE"
    },
    "pulseaudio": {
        "format": "AUD {volume}%",
        "format-muted": "AUD MUTE",
        "on-click": "pavucontrol"
    },
    "battery": {
        "states": { "warning": 30, "critical": 15 },
        "format": "PWR {capacity}%",
        "format-charging": "PWR +{capacity}%"
    }
}
