GRUB_TIMEOUT=5
GRUB_DISTRIBUTOR="$(sed 's, release .*$,,g' /etc/system-release)"
GRUB_DEFAULT=saved
GRUB_DISABLE_SUBMENU=true
#GRUB_TERMINAL_OUTPUT=console
GRUB_CMDLINE_LINUX="rd.luks.uuid=luks-__LUKS_UUID__ rhgb quiet rd.driver.blacklist=nouveau,nova_core modprobe.blacklist=nouveau,nova_core"
GRUB_DISABLE_RECOVERY="true"
GRUB_ENABLE_BLSCFG=true
GRUB_DISABLE_OS_PROBER=false
GRUB_FONT=/boot/grub2/fonts/unicode.pf2
GRUB_THEME="/usr/share/grub/themes/stylish/theme.txt"
#GRUB_THEME="/boot/grub2/themes/glass/theme.txt"
GRUB_GFXMODE=2560x1600,auto
